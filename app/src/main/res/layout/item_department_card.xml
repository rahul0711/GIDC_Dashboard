<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:rippleColor="#1A0B3D91"
    app:strokeColor="#E4EAF5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!--
            DEPARTMENT ICON
            ─────────────────────────────────────────────────
            Set dynamically in RecyclerView adapter:
                holder.binding.ivDeptIcon.setImageResource(dept.iconRes)

            Recommended icon size: 48x48dp vector drawable
            Icon tint is set to brand blue (#0B3D91)
            ─────────────────────────────────────────────────
        -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_department_icon_tile">

            <ImageView
                android:id="@+id/ivDeptIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Department Icon"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                app:tint="@null" />
        </FrameLayout>

        <!--
            DEPARTMENT NAME
            ─────────────────────────────────────────────────
            Set dynamically:
                holder.binding.tvDeptName.text = dept.name
            ─────────────────────────────────────────────────
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeptName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Street Light Department"
                android:textColor="#223A65"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeptSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Manage street light related complaints and services"
                android:textColor="#7C8EA9"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_department_arrow_circle"
            android:contentDescription="Open department"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#2E78F6" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>